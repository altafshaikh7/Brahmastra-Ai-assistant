APP_NAME=BRAHMASTRA AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

API_PREFIX=/api/v1

SECRET_KEY=YOUR_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=INFO

ENABLE_DOCS=true
ENABLE_REDOC=true

CORS_ORIGINS=http://localhost:5173

MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=60