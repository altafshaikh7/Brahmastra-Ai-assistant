BRAHMASTRA_APPLICATION__TITLE=BRAHMASTRA AI
BRAHMASTRA_APPLICATION__VERSION=1.0.0
BRAHMASTRA_APPLICATION__ENVIRONMENT=development
BRAHMASTRA_APPLICATION__DEBUG=true
BRAHMASTRA_APPLICATION__HOST=0.0.0.0
BRAHMASTRA_APPLICATION__PORT=8000

BRAHMASTRA_SECURITY__SECRET_KEY=replace_with_32_character_secret
BRAHMASTRA_JWT__SECRET_KEY=replace_with_32_character_jwt_secret

BRAHMASTRA_AI__PROVIDER=gemini
BRAHMASTRA_AI__API_KEY=replace_with_provider_key
BRAHMASTRA_AI__GEMINI_MODEL=gemini-flash-latest
BRAHMASTRA_MONGODB__URI=mongodb://localhost:27017/brahmastra
BRAHMASTRA_MONGODB__DATABASE_NAME=brahmastra
BRAHMASTRA_CORS__ALLOW_ORIGINS=http://localhost:5173
BRAHMASTRA_CORS__ALLOW_CREDENTIALS=false
BRAHMASTRA_SECURITY__API_SECRET=replace_with_32_character_internal_service_key

# Shared Node-to-Python service key. Keep the same value in Backend/.env.
PYTHON_AI_API_KEY=replace_with_shared_service_key