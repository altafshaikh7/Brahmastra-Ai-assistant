PORT=5000
MONGODB_URI=mongodb://localhost:27017/brahmastra
NODE_ENV=development

# Groq is used for speech-to-text (Whisper) only.
GROQ_API_KEY=your_groq_api_key_here

# Python-AI orchestration service (chat + tools)
PYTHON_AI_URL=http://localhost:8000
PYTHON_AI_TIMEOUT_MS=120000
PYTHON_AI_API_KEY=replace_with_32_character_internal_service_key
CORS_ORIGINS=http://localhost:5173
